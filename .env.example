# Single .env at the repository root is read by docker compose, the backend and the frontend (Vite envDir).
# cp .env.example .env

# ---- Database (docker compose) ----
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_PORT=5432
# POSTGIS_IMAGE=postgis/postgis:16-3.5   # amd64 hosts only; default is the multi-arch imresamu/postgis:16-3.5

# ---- Backend ----
PORT=3000
# 0.0.0.0 so iPhones on the same LAN can reach the Mac
HOST=0.0.0.0
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
# Browser origins allowed to call the backend directly (comma-separated).
# Not needed for the default preview (it goes through the Vite proxy, same origin).
CORS_ORIGIN=http://localhost:5173

# Optional public base URL when served behind a TLS proxy (login then returns wss://.../ws/collector).
# Empty = derived from the address each phone used.
PUBLIC_BASE_URL=

# Detailed sensor-fusion logs (~1 line/s per active session + anchors/corrections)
FUSION_DEBUG=false
# Fusion algorithm computed live for collecting phones (others are for reprocessing / comparison)
ACTIVE_FUSION_VERSION=fusion-v4

# ---- Frontend (Vite, must be prefixed with VITE_) ----
# Leave empty: the preview reaches the backend through the Vite proxy (port taken from PORT above).
# Set only to use a backend on another host, e.g. http://192.168.0.15:3000
VITE_API_BASE_URL=
# VWorld WebGL 3D API key. The key's registered service URL must include http://localhost:5173
VITE_VWORLD_API_KEY=
